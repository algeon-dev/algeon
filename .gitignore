# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

.idea/

# CUDA/cuFile runtime logs
cufile.log
log

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Shared local Python environment for RAPIDS/cuGraph oracle tests.
.venv
.venv/

# Docker staging directory (populated by docker/build.sh, not checked in).
/docker/dist/

# Local Iceberg REST + RustFS loader artifacts (generated parquet + spark ivy
# cache). Regenerated by docker/iceberg-local/load.sh; must not be committed.
/docker/iceberg-local/.loader-data/
/docker/iceberg-local/.ivy-cache/

# private documentation
docs/

# test data
fixture/data/