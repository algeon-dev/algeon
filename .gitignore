# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

.idea/

# CUDA/cuFile runtime logs
cufile.log
log

# Large generated benchmark/test datasets. Everything under tests/data/
# is gitignored by default; specific sub-trees that *are* meant to be
# committed are re-included individually below.
/tests/data/*
# Vendored cuGraph parity fixtures are small (a few hundred KB total) and
# checked in so the parity harness has a stable byte-identical baseline.
!/tests/data/cugraph/

__pycache__/
*.pyc
*.pyo
*.pyd

# Shared local Python environment for RAPIDS/cuGraph oracle tests.
.venv
.venv/
