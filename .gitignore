# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# IDE
.idea/

# Build settings
env.sh
mise.toml
*.log
.DS_Store

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Shared local Python environment for RAPIDS/cuGraph oracle tests.
.venv

# Docker staging directory (populated by docker/stage-docker-payload.sh, not checked in).
/docker/dist/

# Local Iceberg REST + RustFS loader artifacts (generated parquet + spark ivy cache).
# Regenerated by fixture/iceberg-local/load.sh; must not be committed.
/fixture/iceberg-local/.loader-data/
/fixture/iceberg-local/.ivy-cache/
fixture/amazon_reviews_2023

# EMBER2024 fixture: raw JSONL, model, and vectorized/Parquet data are host-provisioned
# and gitignored; prepare.py, prepare.sh, and README.md are versioned.
/fixture/ember2024/*
!/fixture/ember2024/.gitkeep
!/fixture/ember2024/README.md
!/fixture/ember2024/prepare.py
!/fixture/ember2024/prepare.sh

# private documentation
/docs/
/note/

# Local fixture data. The small cuGraph parity corpus under fixture/graph/cugraph
# is versioned; generated and host-provisioned data is not.
/fixture/tpc-h/data
/fixture/tpc-h/models
/fixture/tpc-ds/data
fixture/graph/citation_network
/crates/bench/calibration/*.tsv

