# Rust build and tooling artifacts
debug
target
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# Local build settings
env.sh
mise.toml

# Python artifacts and local environment
__pycache__/
*.pyc
*.pyo
*.pyd
.venv

# Docker staging output
/docker/dist/

# Local fixture data and benchmark output
# The small cuGraph parity corpus under fixture/graph/cugraph is versioned.
/fixture/tpc-h/data
/fixture/tpc-h/models
/fixture/tpc-ds/data
/crates/bench/calibration/*.tsv

# Demo datasets: each dataset's scripts and README are versioned; downloaded
# (raw/), generated, and model data under fixture/demo/<dataset>/ is not.
/fixture/demo/*/*
!/fixture/demo/*/README.md
!/fixture/demo/*/scripts
!/fixture/demo/*/*.sh

