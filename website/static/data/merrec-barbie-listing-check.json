  "queries": [
    {
      "name": "brand_likes",
      "sql": "WITH selected_items AS (\n  SELECT item_id, brand_name,\n         LOWER(COALESCE(name, '')) LIKE '%barbie%' AS is_barbie\n  FROM merrec_items\n  WHERE brand_name IN ('NYX', 'Amc', 'Primark', 'ALDO', 'Taylor Swift', 'Stanley', 'OPI', 'ZARA')\n), likes AS (\n  SELECT i.brand_name, i.is_barbie,\n         e.event_time < TIMESTAMP '2023-07-01 00:00:00' AS may_june\n  FROM merrec_events e JOIN selected_items i ON i.item_id = e.item_id\n  WHERE e.event_type = 'item_like'\n    AND e.event_time >= TIMESTAMP '2023-05-01 00:00:00'\n    AND e.event_time < TIMESTAMP '2023-09-01 00:00:00'\n)\nSELECT brand_name,\n       SUM(CASE WHEN may_june THEN 1 ELSE 0 END) AS total_likes_may_june,\n       SUM(CASE WHEN NOT may_june THEN 1 ELSE 0 END) AS total_likes_july_august,\n       SUM(CASE WHEN may_june AND is_barbie THEN 1 ELSE 0 END) AS barbie_likes_may_june,\n       SUM(CASE WHEN NOT may_june AND is_barbie THEN 1 ELSE 0 END) AS barbie_likes_july_august\nFROM likes\nGROUP BY brand_name\nORDER BY brand_name;",
      "query_id": "498a9137-516b-4c3d-8e0d-3eeeb350fb68",
