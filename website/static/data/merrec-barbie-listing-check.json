    {
      "name": "top_listings",
      "sql": "WITH selected_items AS (\n  SELECT item_id, brand_name, name\n  FROM merrec_items\n  WHERE brand_name IN ('NYX', 'Amc', 'Primark', 'ALDO', 'Taylor Swift', 'Stanley', 'OPI', 'ZARA')\n    AND LOWER(COALESCE(name, '')) LIKE '%barbie%'\n), likes AS (\n  SELECT i.brand_name, i.item_id, i.name,\n         SUM(CASE WHEN e.event_time < TIMESTAMP '2023-07-01 00:00:00' THEN 1 ELSE 0 END) AS likes_may_june,\n         SUM(CASE WHEN e.event_time >= TIMESTAMP '2023-07-01 00:00:00' THEN 1 ELSE 0 END) AS likes_july_august\n  FROM merrec_events e JOIN selected_items i ON i.item_id = e.item_id\n  WHERE e.event_type = 'item_like'\n    AND e.event_time >= TIMESTAMP '2023-05-01 00:00:00'\n    AND e.event_time < TIMESTAMP '2023-09-01 00:00:00'\n  GROUP BY i.brand_name, i.item_id, i.name\n), ranked AS (\n  SELECT brand_name, item_id, name, likes_may_june, likes_july_august,\n         ROW_NUMBER() OVER (PARTITION BY brand_name ORDER BY likes_july_august DESC, item_id) AS rank\n  FROM likes\n)\nSELECT brand_name, item_id, name, likes_may_june, likes_july_august, rank\nFROM ranked\nWHERE rank <= 5\nORDER BY brand_name, rank;",
      "query_id": "964ab009-d562-4d8c-a43a-f9b23cc3fc69",
