{
  "name": "ember2024_full_historical_exact_search",
  "dataset": "EMBER2024",
  "scope": {
    "train_corpus": "All 1,560,000 deduplicated Win32 training files, weeks 0–51",
    "test_queries": "First 10,000 Win32 held-out test files by id, weeks 52–63",
    "features": "512 normalized histogram bins; ID and vector are search inputs; labels and families join after search",
    "k": 10
  },
  "sql_file": "fixture/demo/ember2024/scripts/scale/01_historical_exact_search.sql",
  "sql": "-- Exact squared-L2 reference search over full Win32 train dataset and test queries.\n-- Corpus: full deduplicated Win32 training dataset (~1.56M files) across weeks 0-51.\n-- Queries: 10,000 held-out Win32 test queries from weeks 52-63.\n-- Post-search enrichment joins query and neighbor metadata only after vector search.\nWITH train_index AS (\n    SELECT v.id, v.histogram AS vector\n    FROM ember_research_vectors_train v\n    JOIN ember_metadata_train m ON m.id = v.id\n    WHERE m.file_type = 'Win32'\n    ORDER BY v.id\n), test_queries AS (\n    SELECT v.id, v.histogram AS vector\n    FROM ember_research_vectors_test v\n    JOIN ember_metadata_test m ON m.id = v.id\n    WHERE m.file_type = 'Win32'\n    ORDER BY v.id\n    LIMIT 10000\n)\nSELECT n.query_ordinal,\n       n.query_id,\n       qm.week_id AS query_week,\n       qm.label AS query_label,\n       n.rank,\n       n.neighbor_id,\n       tm.week_id AS neighbor_week,\n       tm.label AS neighbor_label,\n       tm.sha256 AS neighbor_sha256,\n       tm.family AS neighbor_family,\n       n.distance\nFROM cuvs_brute_force_knn(\n    dataset => (SELECT id, vector FROM train_index ORDER BY id),\n    queries => (SELECT id, vector FROM test_queries ORDER BY id),\n    k => 10,\n    metric => 'l2_expanded'\n) n\nJOIN ember_metadata_test qm ON qm.id = n.query_id\nJOIN ember_metadata_train tm ON tm.id = n.neighbor_id\nORDER BY n.query_ordinal, n.rank;\n",
  "query_id": "8bf31405-342b-452d-98bf-9142ebd8f43a",
  "status": "ok",
  "schema": "query_ordinal: uint64 not null\nquery_id: int64 not null\nquery_week: int32 not null\nquery_label: int32 not null\nrank: uint32 not null\nneighbor_id: int64 not null\nneighbor_week: int32 not null\nneighbor_label: int32 not null\nneighbor_sha256: string_view not null\nneighbor_family: string_view not null\ndistance: float not null",
