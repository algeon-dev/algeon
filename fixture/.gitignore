# Ignore everything in fixture/ by default — generated Parquet, JSON, ZIPs,
# scratch outputs, etc. must never be committed.
*

# Re-include the directory metadata and generator sources.
!.gitignore
!README.md
!scripts/
!scripts/**
!data/
!data/.gitkeep
!data/cugraph/
data/cugraph/*
!data/cugraph/*.csv
!data/cugraph/manifest.json
!data/cugraph/oracle/
!data/cugraph/oracle/**
!data/cugraph/ref/
!data/cugraph/ref/**

# Still drop common junk inside scripts/.
scripts/**/__pycache__/
scripts/**/*.pyc
scripts/**/*.pyo
scripts/**/.venv/
scripts/.venv/
