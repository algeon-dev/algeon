{
  "schema": "algeon_tools.single_node_multi_gpu.run_profile",
  "name": "mixed",
  "completion_drain_grace_seconds": 30,
  "scenario_requirements": {
    "require_same_device_overlap": true,
    "require_all_device_progress": true
  },
  "backend": {
    "device_profiles": [
      {
        "ordinal": 0,
        "ownership": "whole_device_exclusive",
        "memory_limit_bytes": 101975851008,
        "backend_reserve_bytes": 0,
        "cache_cap_bytes": 0,
        "default_query_limit_bytes": 8589934592,
        "source_work_per_attempt": 2,
        "max_active_attempts": 4,
        "installation": {
          "stream_pool_size": 12,
          "worker_count": 5,
          "lane_count": 4
        }
      }
    ],
    "queue": {
      "max_queued_attempts": 16,
      "max_queue_wait_ms": 5000
    },
    "native_execution": {
      "max_source_chunk_bytes": 268435456,
      "max_row_groups_per_chunk": 1024,
      "max_retry_attempts": 3,
      "min_retry_chunk_row_groups": 1
    }
  },
  "session": {
    "shared_session_count": 2
  },
  "scheduling": {
    "arrival_mode": "concurrency",
    "concurrency": 4,
    "seed": 20261011,
    "warmup_seconds": 5,
    "measurement_seconds": 60
  },
  "cache": {
    "mode": "disabled"
  },
  "workloads": [
    {
      "kind": "tpch",
      "path": "fixture/tpc-h/data/sf10/parquet",
      "scale": "sf10",
      "preparation_command": "fixture/fixture.sh tpch generate --scale 10 --out-root fixture/tpc-h/data",
      "queries": ["q01", "q06"]
    }
  ]
}
