{
  "schema": "algeon_tools.single_node_multi_gpu.run_profile",
  "name": "recovery",
  "completion_drain_grace_seconds": 30,
  "scenario_requirements": {
    "require_all_device_progress": true
  },
  "qps_envelope": {
    "min_gpu_reaching_completions_per_step": 1,
    "recovery": {
      "baseline_step_index": 0,
      "recovery_step_index": 2,
      "max_p95_latency_multiplier": 3
    }
  },
  "backend": {
    "device_profiles": [
      {
        "ordinal": 0,
        "ownership": "whole_device_exclusive",
        "memory_limit_bytes": 101975851008,
        "backend_reserve_bytes": 0,
        "cache_cap_bytes": 0,
        "default_query_limit_bytes": 8589934592,
        "source_work_per_attempt": 2,
        "max_active_attempts": 1,
        "installation": {
          "stream_pool_size": 3,
          "worker_count": 2,
          "lane_count": 1
        }
      }
    ],
    "queue": {
      "max_queued_attempts": 4,
      "max_queue_wait_ms": 500
    },
    "native_execution": {
      "max_source_chunk_bytes": 268435456,
      "max_row_groups_per_chunk": 1024,
      "max_retry_attempts": 3,
      "min_retry_chunk_row_groups": 1
    }
  },
  "session": {
    "shared_session_count": 2
  },
  "scheduling": {
    "arrival_mode": "rate",
    "seed": 20261011,
    "warmup_seconds": 5,
    "steps": [
      {
        "arrival_rate_per_second": 1,
        "measurement_seconds": 20,
        "rate_overrun": "delay"
      },
      {
        "arrival_rate_per_second": 256,
        "measurement_seconds": 20,
        "rate_overrun": "delay"
      },
      {
        "arrival_rate_per_second": 1,
        "measurement_seconds": 20,
        "rate_overrun": "delay"
      }
    ]
  },
  "cache": {
    "mode": "disabled"
  },
  "workloads": [
    {
      "kind": "tpch",
      "path": "fixture/tpc-h/data/sf10/parquet",
      "scale": "sf10",
      "preparation_command": "fixture/fixture.sh tpch generate --scale 10 --out-root fixture/tpc-h/data",
      "queries": ["q06"]
    }
  ]
}
